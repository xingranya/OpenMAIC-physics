# ─────────────────────────────────────────────────────────────────────────────
# 腾讯云 EdgeOne Pages 部署环境变量模板
#
# 复制为 .env.local（本地开发）或在 EdgeOne 控制台「项目设置 → 环境变量」
# 中逐条配置。控制台配置的环境变量不会进入客户端包。
#
# 平台：EdgeOne Pages（EdgeOne Makers），框架预设 [Next]
# Node 版本：24.5.0
#   ↑ EdgeOne 可选 22.11.0 / 22.17.1 / 24.5.0；OpenMAIC 要求 node >= 22.19.0，
#     前两个不满足，必须选 24.5.0。
# ─────────────────────────────────────────────────────────────────────────────

# ═══ 1. 平台标识（必填） ═══
# 告诉 next.config.ts 当前构建目标是 EdgeOne（无状态边缘运行时），
# 从而关闭 standalone 产物（平台自己托管 Next.js 运行时）。
# 不设置时产物形态与边缘平台不匹配，表现为路由 404 或静态资源缺失。
EDGEONE=1

# ═══ 2. 模型服务（必填，至少一个） ═══
# 服务端解析，前端只经由 /api/* 访问模型，密钥不进入客户端包。
# 可选：OpenAI / Anthropic / Gemini / DeepSeek / Qwen / Kimi / MiniMax / Grok /
#       OpenRouter / Doubao / Hunyuan / MiMo / GLM / Ollama / Lemonade / 任意 OpenAI 兼容 API
#
# ── 方案 A：腾讯云 Makers Models 统一网关（推荐：无需自备第三方厂商密钥）──
# 官方文档：https://cloud.tencent.com/document/product/1552/132748
#   · 统一端点部署在 EdgeOne 边缘节点，OpenAI 兼容协议，SSE 流式原生支持；
#   · 单一 API Key 调用多家主流厂商模型，切换模型只改 DEFAULT_MODEL；
#   · 控制台路径：EdgeOne Makers → Models → API Key → 复制；
#   · 平台「模板部署」时自动注入的变量名是 AI_GATEWAY_API_KEY / AI_GATEWAY_BASE_URL
#     （官方文档 1552/132759），本项目**两个名字都认**：
#     Key 优先 MAKERS_MODELS_KEY，其次 AI_GATEWAY_API_KEY；
#     端点优先 OPENAI_BASE_URL，其次 AI_GATEWAY_BASE_URL，最后退回上面的统一端点。
#     两者都映射为 openai provider，无需改写成 OPENAI_API_KEY。
#   · 免费版配额（出处：腾讯云《限制与配额》1552/132789）：
#     Models 网关的**内置模型免费额度 50 万 token/月**，单个请求最长 300 秒；
#     同页的「20 万次执行/月」是 **Agents** 的配额，本项目未启用 Agent Workbench，不占用。
#   · 下列三行是等价的手工写法，二选一即可。
MAKERS_MODELS_KEY=
# AI_GATEWAY_API_KEY=                          # 平台模板部署自动注入时用它（等价于上行）
# AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1   # 同上，端点可省略
# MAKERS_MODELS=@makers/deepseek-v4-flash      # 可选：模型白名单，逗号分隔
# OPENAI_BASE_URL=https://ai-gateway.edgeone.link/v1   # 可选：显式指定统一端点

# —— MiniMax（与本仓库开发工具链同源，成本可控）——
# MINIMAX_API_KEY=
# MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic/v1
# MINIMAX_MODELS=MiniMax-M2.7-highspeed

# —— DeepSeek ——
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# —— Kimi ——
# KIMI_API_KEY=
# KIMI_BASE_URL=https://api.moonshot.cn/v1

# —— 通义千问 ——
# QWEN_API_KEY=
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# —— 智谱 GLM ——
# GLM_API_KEY=
# GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# —— 本地 Ollama（完全离线，零成本；未安装请注释）——
# OLLAMA_API_KEY=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# ═══ 3. 默认模型路由 ═══
# 形如 <provider>:<model>。OpenMAIC 的 provider preset 名称见
# packages/docs/content/docs/supported-models.mdx
#
# 用第三方厂商时（方案 B）：**必填**，且必须带 provider 前缀，
#   否则解析不出 providerId，调用会直接失败。
#   DEFAULT_MODEL=minimax:MiniMax-M2.7-highspeed
#
# 用 Makers Models 统一网关时（方案 A）：**可以不填**。
#   只配 MAKERS_MODELS_KEY 时，代码会自动把默认模型推导为
#   openai:@makers/deepseek-v4-flash（官方文档的内置模型）；
#   显式写出来只是为了让控制台上的配置一目了然。
#   想换成别的模型：用 MAKERS_MODELS 指定白名单，或先跑
#   `MAKERS_MODELS_KEY=<your-key> node scripts/check-makers-models.mjs`
#   查当前账号实际可用的模型 id。
DEFAULT_MODEL=openai:@makers/deepseek-v4-flash

# 联网调研（可选）。开启后课堂内容可引用实时信息，弱网演示时建议关闭。
# WEB_SEARCH_ENABLED=1

# ═══ 3b. 关闭某个模型 provider（可选） ═══
# 形如 <PREFIX>_ENABLED=false。被关掉的 provider 不会拿到任何密钥、
# 不会出现在客户端的模型列表里，平台自动注入的 Makers Key 也不会把它复活。
#
# 什么时候需要：EdgeOne 模板部署可能自动注入 MAKERS_MODELS_KEY；
# 若你不想用这条通道、或只想临时屏蔽某个厂商，显式关掉最省事。
#
# 可用前缀与 LLM_ENV_MAP 一致：OPENAI / DEEPSEEK / QWEN / KIMI / MINIMAX /
# ANTHROPIC / GOOGLE / GLM / GROK / OPENROUTER / DOUBAO / TENCENT / OLLAMA …
# 不配 = 保持默认（由各自的 *_API_KEY 决定是否启用）。

# OPENAI_ENABLED=false
# DEEPSEEK_ENABLED=false

# ═══ 4. 站点访问控制（强烈建议） ═══
# 站点级口令：至少 16 位随机字符。这是保护部署的唯一凭据——
# 没有它，任何能访问该地址的人都能修改甚至删除整个课程库。
# 7 天有效，存于签名 HTTP-only Cookie。
# 生成：openssl rand -base64 24
ACCESS_CODE=

# 仅限**本地 http://localhost 演示**：允许口令 Cookie 不带 Secure。
# 生产环境绝对不要设置——设了它，口令票据就能在明文 http 上传输。
# 本地 `next start` 也是 NODE_ENV=production，靠 NODE_ENV 区分不开，只能显式开。
# ALLOW_INSECURE_ACCESS_COOKIE=1

# ═══ 5. 品牌与文案（可选） ═══
# NEXT_PUBLIC_SITE_NAME=大学物理 AI 智慧课堂
# NEXT_PUBLIC_SITE_TAGLINE=诊断 · 匹配 · 闯关 · 实验 · 课堂

# ═══ 6. 媒体能力（可选，按需开启） ═══
# 未配置时课件只生成文字与图形，朗读与配图会跳过，不会阻塞课堂生成。
# TTS_MINIMAX_API_KEY=
# TTS_MINIMAX_BASE_URL=https://api.minimaxi.com
# IMAGE_MINIMAX_API_KEY=
# IMAGE_MINIMAX_BASE_URL=https://api.minimaxi.com
# IMAGE_OPENAI_API_KEY=
# IMAGE_OPENAI_BASE_URL=https://api.openai.com/v1

# ═══ 7. 明确不要设置（边缘部署互斥项） ═══
# 本项目部署在无状态边缘平台，以下变量与该形态互斥。
# 一旦误设，服务端启动断言会直接抛错（见 lib/config/deployment-mode.ts）。
#
# DATABASE_URL=postgres://...        # 需长驻进程 + 固定数据库
# NEXT_PUBLIC_PERSISTENCE=1          # 会切换到服务端持久化
# NEXT_PUBLIC_PRO_WORKBENCH_ENABLED=true   # Agent Workbench 需 PostgreSQL 租约
# OPENMAIC_AGENT_RUNTIME_ENABLED=true       # 后台 runner 需常驻进程
# RENDER_SERVICE_URL=http://...       # MP4 渲染服务需 Docker + Chromium

# ═══ 8. EdgeOne KV / Blob（可选） ═══
# KV：1GB 免费、10 命名空间、60s 最终一致、单值 ≤ 25MB、key ≤ 512B，
#     仅在 Edge Functions 中可用。适合放课程目录索引与访问统计。
# 控制台开通 → 创建命名空间 → 绑定项目 → 记录变量名（代码中通过绑定名访问）。
#
# Blob：对象存储、单值 ≤ 25MB、支持目录层级、60s 最终一致（可开强一致模式），
#     Edge/Cloud Functions 均可，SDK 为 @tencent/pages-blob。
#     适合放 AI 生成的图片与音频，实现跨浏览器共享。
#
# 注意：两者都是「最终一致」，课程与学生记录一律走浏览器强一致存储，
#       避免评委刷新两次看到不同内容。
