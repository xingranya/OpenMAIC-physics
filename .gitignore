*.tsbuildinfo
next-env.d.ts

# IDE
.idea
.vscode

# worktrees
.worktrees

# generated data
/data
/logs

# docs
# 上游用整条 /docs 忽略本地文档目录；参赛材料必须进版本库，
# 因此只忽略 docs/ 下除「参赛」以外的内容。
/docs/*
!/docs/参赛
# 上线收尾说明：交付时给下一位接手者的「改了什么 / 线上什么结果 / 还没验证什么」，
# 必须进版本库——只存在某个人本机上的交接文档等于没有。
!/docs/上线收尾说明.md
# Eval results
eval/whiteboard-layout/results/
eval/outline-language/results/
eval/orchestration/results/
eval/orchestration/results-answering/
eval/orchestration/results-answer-content/

# e2e screenshot artifacts
e2e/screenshots/

# local-only sandbox/demo pages (do not ship)
/app/slide-renderer-demo

# local e2e screenshots for #619 review
e2e/__screenshots-619/
/.playwright-mcp/

# Temporary render-service sources extracted by the mixed-pool regression test
render-service/.owner-bound-parent-*/

# 本地 pnpm 内容寻址存储（为跨平台原生模块解析而置于仓库内，不入版本控制）
/.pnpm-store/
# 本地构建临时目录
/.tmp/

# EdgeOne CLI 生成的项目关联信息（不属于源码）
/.edgeone/
